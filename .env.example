# =============================================================================
# AI Trading Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=AI Trading Platform
APP_VERSION=0.1.0
DEBUG=false

# --- Trading Mode ---
# Options: BACKTEST, PAPER, LIVE
# Default: BACKTEST (safest mode - no real money at risk)
TRADING_MODE=BACKTEST

# --- Live Trading Safety Gates ---
# ALL THREE of the following must be set to enable live trading.
# This is intentionally difficult to prevent accidental activation.
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_REAL_MONEY_IS_AT_RISK

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trading:trading_dev_password@localhost:5432/trading_platform

# --- Redis (optional for Milestone 1) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: json (production) or console (development)
LOG_FORMAT=console

# --- Security ---
# Generate a strong random key for production
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-REAL-SECRET-KEY
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- API Keys (future milestones) ---
# GEMINI_API_KEY=
# BROKER_API_KEY=
# BROKER_API_SECRET=
